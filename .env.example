# Environment template (copy values into your host dashboard — never commit real secrets)
# App / runtime
NODE_ENV=production
PORT=8080

# Public URL of the deployed app, e.g. https://meridian.example.com — used to
# build OAuth callback URLs. Set it in production; locally it defaults to the
# request origin.
APP_URL=

# MongoDB (required primary NoSQL database — geo catalog, weather cache, accounts, sessions, saved places)
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# Weather (open-meteo default works keyless; met-norway also keyless)
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Flights (AviationStack or AirLabs for live schedules/status/boards; OpenSky works for ADS-B)
FLIGHT_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional map SDK keys (OSM / ESRI Satellite / OpenFreeMap 3D tiles work keyless by default)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
APPLE_MAPS_TOKEN=
VITE_APPLE_MAPS_TOKEN=

# Optional AI assistant (deterministic geo/weather/flight engine runs without an API key)
AI_API_KEY=
XAI_API_KEY=

# ==============================================================================
# AUTHENTICATION & SECURITY (set in your hosting provider dashboard)
# ==============================================================================
# A sign-in method appears on the sign-in screen only once its variables below
# are set. Run `npm run auth:doctor` to see what is live and to test each
# credential against its provider before you deploy.
#
# Required in production: at least 32 random chars (openssl rand -hex 32)
SESSION_SECRET=

# --- Email codes + password reset (Resend — https://resend.com) ---------------
# 1. Add and verify your sending domain in Resend (DNS records: SPF + DKIM).
# 2. Create an API key with "Sending access".
# EMAIL_FROM must be an address on that verified domain.
EMAIL_PROVIDER_KEY=
EMAIL_FROM=Meridian <noreply@yourdomain.com>

# --- Phone codes (Twilio — https://console.twilio.com) ------------------------
# SMS_PROVIDER_KEY = Account SID (AC…), SMS_PROVIDER_SECRET = Auth Token.
# Then choose ONE way to send:
#   a) SMS_VERIFY_SERVICE_SID (VA…) — recommended. Twilio Verify picks a
#      compliant sender in each country and blocks SMS fraud. Create a service
#      under Verify → Services with a 6-digit code length.
#   b) SMS_FROM — your own Twilio number (+15550000000) or a Messaging Service
#      SID (MG…). You are responsible for sender registration (US A2P 10DLC,
#      India DLT, …) in every country you send to.
SMS_PROVIDER_KEY=
SMS_PROVIDER_SECRET=
SMS_VERIFY_SERVICE_SID=
SMS_FROM=
# Optional ceilings on codes sent per hour across all visitors (defaults 300 / 1000)
OTP_SMS_HOURLY_LIMIT=
OTP_EMAIL_HOURLY_LIMIT=

# --- OAuth / social sign-in ---------------------------------------------------
# Register this exact callback URL with each provider (https in production):
#   ${APP_URL}/api/auth/<provider>/callback
# The *_CALLBACK_URL variables are only needed to override that default.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized redirect URI: ${APP_URL}/api/auth/google/callback
#   Publish the OAuth consent screen ("In production") or only test users can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Microsoft Entra admin center → App registrations → New registration (Web)
#   Redirect URI: ${APP_URL}/api/auth/microsoft/callback
#   Supported account types: "any organizational directory and personal accounts"
#   for MICROSOFT_TENANT_ID=common.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=

# Sign in with Apple → Services ID (APPLE_CLIENT_ID) + Sign in with Apple key (.p8)
#   Return URL: ${APP_URL}/api/auth/apple/callback   (HTTPS only — not localhost)
#   APPLE_PRIVATE_KEY: the .p8 contents on one line, newlines written as \n
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=

# Login with Amazon (optional)
#   Allowed Return URL: ${APP_URL}/api/auth/amazon/callback
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CALLBACK_URL=

# Local seeding guard (required for POST /api/admin/seed in production / when set)
MERIDIAN_SEED_TOKEN=
