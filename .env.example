# Environment template (copy values into your host dashboard — never commit real secrets)
# App / runtime
NODE_ENV=production
PORT=8080

# Deployment URLs (OAuth callbacks and same-origin origins; defaults from request origin locally)
# APP_URL=https://meridian.example.com
APP_URL=
FRONTEND_URL=
API_URL=

# MongoDB (required primary NoSQL database — geo catalog, weather cache, accounts, sessions, saved places)
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# Frontend client (Vite exposes ONLY VITE_* variables to browser)
VITE_API_URL=

# Weather (open-meteo default works keyless; met-norway also keyless)
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Flights (AviationStack or AirLabs for live schedules/status/boards; OpenSky works for ADS-B)
FLIGHT_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional map SDK keys (OSM / ESRI Satellite / OpenFreeMap 3D tiles work keyless by default)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
APPLE_MAPS_TOKEN=
VITE_APPLE_MAPS_TOKEN=

# Optional AI assistant (deterministic geo/weather/flight engine runs without an API key)
AI_API_KEY=
XAI_API_KEY=

# ==============================================================================
# AUTHENTICATION & SECURITY (set in your hosting provider dashboard)
# ==============================================================================
# Required in production: at least 32 random chars (openssl rand -hex 32)
SESSION_SECRET=
# Optional dedicated secrets (defaults derive cleanly if unset)
COOKIE_SECRET=
CSRF_SECRET=

# Transactional Email OTP (Resend API key) — omit for local console logging only
EMAIL_PROVIDER_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Transactional SMS OTP (Twilio Account SID / Auth Token / Sender number)
SMS_PROVIDER_KEY=
SMS_PROVIDER_SECRET=
SMS_FROM=+15550000000

# OAuth / Social SSO (enable per provider; callback URL defaults to ${APP_URL}/api/auth/oauth/callback/<provider>)
# Google Cloud Console → OAuth 2.0 Client ID (Web)
#   Redirect URI: ${APP_URL}/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Microsoft Entra / Azure AD → App Registration (Web)
#   Redirect URI: ${APP_URL}/api/auth/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=

# Sign in with Apple → Services ID + Sign in with Apple private key (.p8)
#   Return URL: ${APP_URL}/api/auth/oauth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=

# Login with Amazon (optional)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CALLBACK_URL=

# Optional Redis URL for shared rate limiting across multiple instances
REDIS_URL=

# Local seeding guard (required for POST /api/admin/seed in production / when set)
MERIDIAN_SEED_TOKEN=
