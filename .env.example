# MERIDIAN environment — copy values into your hosting provider's dashboard.
# NEVER commit real secrets. Only VITE_*-prefixed vars reach the browser.
NODE_ENV=production
PORT=8080

# Public origin of the deployed app (used for OAuth callbacks when set;
# otherwise callbacks derive from the request origin — same-origin default).
APP_URL=
FRONTEND_URL=
API_URL=

# MongoDB Atlas (primary database). Unset locally → embedded PGLite fallback.
MONGODB_URI=

# Postgres (legacy fallback / auth tables). Unset locally → embedded PGLite.
DATABASE_URL=

# Frontend base URL for API calls (same-origin default; set when split).
VITE_API_URL=

# Weather: Open-Meteo needs no key. Only set if you switch providers.
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Flight schedule/status provider (licensed). Unset → honest "unavailable" states.
FLIGHT_API_KEY=
# OpenSky OAuth (optional; raises live-traffic quota). Keyless works anonymously.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Maps (optional; adapters stay inert without them).
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
APPLE_MAPS_TOKEN=
VITE_APPLE_MAPS_TOKEN=

# AI (optional; rule-based assistant works without it).
AI_API_KEY=
XAI_API_KEY=

# --- Authentication (MongoDB-backed sessions + OTP + OAuth) ---
# Required for any sign-in. Minimum 32 random characters. Never expose to the
# browser — sessions travel in HttpOnly, SameSite=Lax cookies (Secure in prod).
SESSION_SECRET=
# Optional extras (reserved; SESSION_SECRET signs both today):
COOKIE_SECRET=
CSRF_SECRET=

# Email OTP delivery via Resend. Unset → honest 503, never fake delivery.
EMAIL_PROVIDER_KEY=
EMAIL_FROM=

# Phone OTP delivery via Twilio. Unset → honest 503, never fake delivery.
SMS_PROVIDER_KEY=
SMS_PROVIDER_SECRET=
SMS_FROM=

# OAuth — each provider activates only when its vars are set.
# Register the callback URL in each provider console as:
#   <APP_URL>/api/auth/<provider>/callback
# (e.g. https://meridian.example.com/api/auth/google/callback).
# The *_CALLBACK_URL overrides below are optional and only needed when the
# public origin differs from the incoming request (proxy / split deploy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CALLBACK_URL=

# Cache (optional; in-process cache is the default).
REDIS_URL=

# Local seeding guard (PGLite dev only accepts unsealed seed without a token).
MERIDIAN_SEED_TOKEN=
